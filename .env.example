# Copy to .env.local and fill in. Never commit real values.

# Public address of the site. Used for canonical links, sitemap, robots.txt and share images.
# On Vercel this falls back to the project's production domain if left empty.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email delivery (https://resend.com). Without these, requests are stored locally but no mail is sent.
RESEND_API_KEY=
# Sender on a domain verified in Resend, for example: Terrantia <stay@yourdomain.com>
MAIL_FROM=
# Inbox that receives booking requests, enquiries and newsletter signups.
RESORT_EMAIL=

# Folder for the local request store (JSON Lines). Defaults to .data in the project root.
# It holds guest details: keep it out of git and out of public/.
# Serverless hosts such as Vercel do not keep this folder, so email is the only delivery there.
# DATA_DIR=.data
